{
    "name": "ziadoz/envobj",
    "description": "PHP env var config library inspired by Python's Pydantic Settings",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "suggest": {
        "vlucas/phpdotenv": "Required to use DotEnvReader"
    },
    "autoload": {
        "psr-4": {
            "Ziadoz\\EnvObj\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ziadoz\\EnvObj\\Tests\\": "tests/"
        }
    }
}
